#!/usr/bin/env bash
# =============================================================================
# Dolores — Archiso Install Script
# =============================================================================
# Run this from the live ISO to install Dolores to disk.
# Usage: install-dolores
# =============================================================================
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${GREEN}[INFO]${RESET}  $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*"; }
header()  { echo -e "\n${CYAN}${BOLD}═══ $* ═══${RESET}\n"; }

die()     { error "$*"; exit 1; }

# ── Privilege check ──────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "This script must be run as root."

# ── Welcome ──────────────────────────────────────────────────────────────────
header "Dolores Installer"
echo "This will install Arch Linux with your configured desktop environment."
echo "ALL DATA ON THE TARGET DISK WILL BE ERASED."
echo ""

partition_name() {
    local disk="$1"
    local part="$2"

    if [[ "$disk" == *[0-9] ]]; then
        printf '%sp%s' "$disk" "$part"
    else
        printf '%s%s' "$disk" "$part"
    fi
}

# ── User prompts ─────────────────────────────────────────────────────────────
header "User Configuration"

read -rp "Username: " USERNAME
[[ -n "$USERNAME" ]] || die "Username cannot be empty."
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || die "Username must be a valid Linux user name."

read -rsp "Password for $USERNAME: " USER_PASS; echo
[[ -n "$USER_PASS" ]] || die "Password cannot be empty."
read -rsp "Confirm password: " USER_PASS_CONFIRM; echo
[[ "$USER_PASS" == "$USER_PASS_CONFIRM" ]] || die "Passwords do not match."

read -rsp "Root password (leave empty to disable root login): " ROOT_PASS
echo

read -rp "Hostname [dolores]: " HOSTNAME
HOSTNAME="${HOSTNAME:-dolores}"
[[ "$HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || die "Hostname must contain only letters, numbers, and hyphens."
[[ "$HOSTNAME" != *-- ]] || die "Hostname must not contain consecutive hyphens."

# ── Locale & Timezone ────────────────────────────────────────────────────────
header "Locale & Timezone"

echo "Available locales:"
{ grep -E '^[^#].*UTF-8' /etc/locale.gen | head -20 | sed 's/^/  /'; } || true
echo ""
read -rp "Locale [en_US.UTF-8]: " LOCALE
LOCALE="${LOCALE:-en_US.UTF-8}"
grep -Eq "^#?${LOCALE}[[:space:]]+UTF-8" /etc/locale.gen || die "Locale ${LOCALE} is not available in /etc/locale.gen."

echo ""
echo "Available timezones ( Continent/Region ): "
read -rp "Timezone [America/New_York]: " TIMEZONE
TIMEZONE="${TIMEZONE:-America/New_York}"
[[ -f "/usr/share/zoneinfo/${TIMEZONE}" ]] || die "Timezone ${TIMEZONE} is not valid."

read -rp "Keyboard layout [dk]: " KEYMAP
KEYMAP="${KEYMAP:-dk}"

read -rp "Console font [ter-v16n]: " CONSOLE_FONT
CONSOLE_FONT="${CONSOLE_FONT:-ter-v16n}"

# ── Disk Selection ───────────────────────────────────────────────────────────
header "Disk Selection"

echo "Available disks:"
lsblk -d -o NAME,SIZE,MODEL | sed 's/^/  /'
echo ""
read -rp "Target disk (e.g. /dev/nvme0n1, /dev/sda): " DISK

[[ -b "$DISK" ]] || die "$DISK is not a valid block device."

warn "This will WIPE $DISK completely!"
read -rp "Type 'YES I AM SURE' to continue: " CONFIRM
[[ "$CONFIRM" == "YES I AM SURE" ]] || die "Installation aborted."

# ── Partitioning ─────────────────────────────────────────────────────────────
header "Partitioning $DISK"

info "Wiping partition table..."
wipefs -a "$DISK" &>/dev/null
sgdisk --zap-all "$DISK" &>/dev/null || sgdisk -Z "$DISK" &>/dev/null

info "Creating partitions..."
# BIOS boot partition for GRUB on GPT (1M)
sgdisk -n1:1M:+1M -t1:ef02 -c1:"BIOS Boot" "$DISK"
# EFI System Partition (512M)
sgdisk -n2:0:+512M -t2:ef00 -c2:"EFI System" "$DISK"
# Root partition (rest of disk)
sgdisk -n3:0:0 -t3:8304 -c3:"Linux Root" "$DISK"

sync
partx -u "$DISK" 2>/dev/null || true
udevadm settle

EFI_PART="$(partition_name "$DISK" 2)"
ROOT_PART="$(partition_name "$DISK" 3)"

# ── Formatting ───────────────────────────────────────────────────────────────
header "Formatting"

info "Formatting EFI partition (FAT32)..."
mkfs.fat -F32 -n "EFI" "$EFI_PART"

info "Formatting root partition (ext4)..."
mkfs.ext4 -F -L "ROOT" "$ROOT_PART"

# ── Mounting ─────────────────────────────────────────────────────────────────
header "Mounting"

info "Mounting root..."
mount "$ROOT_PART" /mnt

info "Mounting EFI..."
mkdir -p /mnt/boot
mount "$EFI_PART" /mnt/boot

# ── Pacstrap ─────────────────────────────────────────────────────────────────
header "Installing base system"

# Configure CachyOS repos on target BEFORE pacstrap so it can pull from them
mkdir -p /mnt/etc/pacman.d
cp /etc/pacman.d/cachyos-mirrorlist /mnt/etc/pacman.d/cachyos-mirrorlist 2>/dev/null || true
cp /etc/pacman.conf /mnt/etc/pacman.conf 2>/dev/null || true

info "Initializing pacman keyring..."
pacman-key --init
pacman-key --populate archlinux cachyos

info "Refreshing package databases..."
rm -f /var/lib/pacman/sync/*.db* /var/lib/pacman/sync/*.files*
pacman -Syy --noconfirm --needed archlinux-keyring cachyos-keyring

info "Installing packages (this may take a while)..."
pacstrap -K -C /etc/pacman.conf /mnt base base-devel archlinux-keyring cachyos-keyring linux-zen linux-zen-headers linux-firmware \
    opendoas zsh grml-zsh-config fastfetch gptfdisk dosfstools mkinitcpio \
    arch-install-scripts efibootmgr grub openssh \
    iwd dhcpcd networkmanager network-manager-applet wpa_supplicant wireless_tools wireless-regdb \
    pipewire pipewire-alsa pipewire-pulse pipewire-jack wireplumber alsa-utils \
    mesa libva-mesa-driver mesa-vdpau vulkan-virtio \
    greetd greetd-tuigreet mangowm waybar rofi ghostty swaybg swaync swayidle \
    xorg-xwayland xorg-xhost xdg-desktop-portal xdg-desktop-portal-gtk xdg-user-dirs polkit \
    git wget curl tmux fzf yazi stow mpv mpd mpc ffmpeg python bun \
    man-db man-pages less neovim nano htop btop bat ripgrep fd zoxide jq \
    unzip p7zip tar rsync reflector netctl dnsutils bind ethtool \
    usbutils pciutils lsof strace lm_sensors smartmontools cpupower power-profiles-daemon \
    qemu-guest-agent \
    terminus-font ttf-jetbrains-mono ttf-cascadia-code-nerd ttf-cascadia-mono-nerd \
    noto-fonts noto-fonts-emoji noto-fonts-cjk noto-fonts-extra \
    ttf-font-awesome otf-font-awesome ttf-nerd-fonts-symbols \
    librewolf-bin grim slurp wl-clipboard pavucontrol pamixer brightnessctl playerctl \
    rmpc beets

info "Generating fstab..."
genfstab -L /mnt >> /mnt/etc/fstab

# ── Chroot Setup ─────────────────────────────────────────────────────────────
header "Configuring installed system"

mkdir -p /mnt/root

# ── Install script (runs inside chroot) ──────────────────────────────────────
cat <<'CHROOT_SCRIPT' > /mnt/root/post-install.sh
#!/usr/bin/env bash
set -euo pipefail

# Read variables passed from the host
source /root/install-vars.sh

# ── Locale ───────────────────────────────────────────────────────────────
echo "Setting up locale..."
grep -q "^#${LOCALE}" /etc/locale.gen && sed -i "s/^#${LOCALE}/${LOCALE}/" /etc/locale.gen || true
locale-gen
echo "LANG=${LOCALE}" > /etc/locale.conf
export LANG=${LOCALE}

# ── Timezone ─────────────────────────────────────────────────────────────
echo "Setting timezone..."
ln -sf "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime
hwclock --systohc

# ── Hostname ─────────────────────────────────────────────────────────────
echo "Setting hostname..."
echo "${HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
EOF

# ── Keymap ───────────────────────────────────────────────────────────────
echo "${KEYMAP}" > /etc/vconsole.conf
echo "FONT=${CONSOLE_FONT}" >> /etc/vconsole.conf

# ── Mkinitcpio ───────────────────────────────────────────────────────────
echo "Rebuilding initramfs..."
mkinitcpio -P

# ── Bootloaders ─────────────────────────────────────────────────────────
echo "Installing GRUB for legacy BIOS boot..."
grub-install --target=i386-pc "${DISK}"

mkdir -p /boot/grub
cat > /boot/grub/grub.cfg <<'GRUBEOF'
set timeout=3
set default=0

menuentry "Arch Linux (Zen)" {
    linux /vmlinuz-linux-zen root=LABEL=ROOT rw
    initrd /initramfs-linux-zen.img
}
GRUBEOF

if [[ -d /sys/firmware/efi ]]; then
    echo "Installing systemd-boot for UEFI boot..."
    bootctl install
    mkdir -p /boot/loader/entries
    cat > /boot/loader/loader.conf <<'LOADEREOF'
default  arch.conf
timeout  3
console-mode max
editor   no
LOADEREOF

    cat > /boot/loader/entries/arch.conf <<ENTRYEOF
title   Arch Linux (Zen)
linux   /vmlinuz-linux-zen
initrd  /initramfs-linux-zen.img
options root=LABEL=ROOT rw
ENTRYEOF
else
    echo "Skipping systemd-boot install; live environment is not booted in UEFI mode."
fi

# ── OS release ───────────────────────────────────────────────────────────
echo "Writing Dolores OS metadata..."
rm -f /etc/os-release /usr/lib/os-release
cat > /usr/lib/os-release <<'OSRELEASEEOF'
NAME="Dolores Linux"
PRETTY_NAME="Dolores Linux"
ID=dolores
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="0;36"
HOME_URL="https://raske.xyz"
DOCUMENTATION_URL="https://wiki.archlinux.org/"
SUPPORT_URL="https://wiki.archlinux.org/"
BUG_REPORT_URL="https://github.com/mikkelrask/dolores/issues"
OSRELEASEEOF
ln -s ../usr/lib/os-release /etc/os-release

# ── User creation ────────────────────────────────────────────────────────
echo "Creating user: ${USERNAME}..."
USER_GROUPS=()
for group in wheel audio video input storage; do
    if getent group "${group}" >/dev/null; then
        USER_GROUPS+=("${group}")
    fi
done
useradd -m -G "$(IFS=,; echo "${USER_GROUPS[*]}")" -s /usr/bin/zsh "${USERNAME}"
echo "${USERNAME}:${USER_PASS}" | chpasswd

if [[ -n "${ROOT_PASS}" ]]; then
    echo "root:${ROOT_PASS}" | chpasswd
else
    passwd -l root
fi

# doas — wheel group with persist and inherited environment
echo "permit persist keepenv :wheel" > /etc/doas.conf
chmod 0400 /etc/doas.conf

# makepkg should use doas when installing built packages as an unprivileged user.
if grep -q '^#\?PACMAN_AUTH=' /etc/makepkg.conf; then
    sed -i 's/^#\?PACMAN_AUTH=.*/PACMAN_AUTH=(doas)/' /etc/makepkg.conf
else
    echo 'PACMAN_AUTH=(doas)' >> /etc/makepkg.conf
fi

# ── CachyOS repos ────────────────────────────────────────────────────────
echo "Setting up CachyOS repos..."
cat > /etc/pacman.d/cachyos-mirrorlist <<'MIRRORSEOF'
Server = https://mirror.cachyos.org/repo/$arch/$repo
MIRRORSEOF

# Make sure pacman.conf has CachyOS repos
if ! grep -q '\[cachyos\]' /etc/pacman.conf; then
    cat >> /etc/pacman.conf <<'PACMANEOF'

# CachyOS Repos
[cachyos]
Include = /etc/pacman.d/cachyos-mirrorlist
SigLevel = Optional TrustAll DatabaseNever
PACMANEOF
fi

# Refresh package databases
pacman -Sy --noconfirm

# ── Build & install paru ─────────────────────────────────────────────────
echo "Building paru from AUR..."

# Install base-devel if not already present
pacman -S --noconfirm --needed base-devel

# Build paru as the user, then install the built package as root.
su - "${USERNAME}" -c "
    cd /tmp
    rm -rf paru-bin
    git clone https://aur.archlinux.org/paru-bin.git
    cd paru-bin
    makepkg --noconfirm
"
pacman -U --noconfirm /tmp/paru-bin/*.pkg.tar.zst

# ── Services ─────────────────────────────────────────────────────────────
echo "Enabling services..."
systemctl enable greetd.service
systemctl enable NetworkManager.service
systemctl enable qemu-guest-agent.service
systemctl --global enable pipewire.service
systemctl --global enable pipewire-pulse.service
systemctl --global enable wireplumber.service
systemctl enable sshd.service

# ── Greetd configuration ───────────────────────────────────────────────
echo "Configuring greetd..."
mkdir -p /etc/greetd

cat > /etc/greetd/config.toml <<GREETDEOF
[terminal]
vt = 1

[default_session]
command = "tuigreet --cmd mango"
user = "${USERNAME}"
GREETDEOF

# ── Dotfiles (clone + stow) ──────────────────────────────────────────
echo "Cloning dotfiles..."
DOTFILES_DIR="/home/${USERNAME}/.dotfiles"
if su - "${USERNAME}" -c "git clone https://github.com/mikkelrask/dotfiles.git \"${DOTFILES_DIR}\""; then
    echo "Stowing dotfile packages..."
    cd "${DOTFILES_DIR}"

    # Remove generated shell defaults that conflict with managed dotfiles.
    rm -f "/home/${USERNAME}/.zshrc" "/home/${USERNAME}/.zshenv" "/home/${USERNAME}/.zprofile" "/home/${USERNAME}/.zlogin" "/home/${USERNAME}/.zlogout"

    # Stow relevant packages for Mango/Wayland setup
    STOW_PKGS=(
        zsh
        ghostty
        waybar
        rofi
        mpd
        mpv
        yazi
        tmux
        git
        nvim
        lazygit
        themes
        mango
        gtk
        paru
        cava
        utils
    )

    for pkg in "${STOW_PKGS[@]}"; do
        if [[ -d "${pkg}" ]]; then
            echo "  Stowing: ${pkg}"
            stow "${pkg}" --adopt -t "/home/${USERNAME}"
        else
            echo "  Skipping (not found): ${pkg}"
        fi
    done
else
    echo "Warning: dotfiles clone failed; continuing without stowing dotfiles."
fi

# Stow can be extended by adding packages to the array above.
# Skipped (different WM/terminal/launcher):
#   hyprland, i3, zwm     — other WMs
#   kitty, wezterm        — other terminals
#   wofi, polybar         — other launcher/bar
#   ranger                — replaced by yazi
#   nixos                 — NixOS config
#   dunst, compton, picom — X11/different notification
#   newsboat, obsidian, rmpc, eww — optional/manual

# ── XDG directories ───────────────────────────────────────────────────
echo "Creating XDG user directories..."
mkdir -p \
    "/home/${USERNAME}/.config" \
    "/home/${USERNAME}/Desktop" \
    "/home/${USERNAME}/Documents" \
    "/home/${USERNAME}/Downloads" \
    "/home/${USERNAME}/Music" \
    "/home/${USERNAME}/Pictures" \
    "/home/${USERNAME}/Public" \
    "/home/${USERNAME}/Templates" \
    "/home/${USERNAME}/Videos"

cat > "/home/${USERNAME}/.config/user-dirs.dirs" <<'XDGDIREOF'
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_TEMPLATES_DIR="$HOME/Templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_MUSIC_DIR="$HOME/Music"
XDG_PICTURES_DIR="$HOME/Pictures"
XDG_VIDEOS_DIR="$HOME/Videos"
XDGDIREOF

# ── Fix permissions ────────────────────────────────────────────────────
chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}"

echo ""
echo "Post-install configuration complete!"
CHROOT_SCRIPT

chmod +x /mnt/root/post-install.sh

# Write install variables for the chroot script
{
    printf 'USERNAME=%q\n' "${USERNAME}"
    printf 'USER_PASS=%q\n' "${USER_PASS}"
    printf 'ROOT_PASS=%q\n' "${ROOT_PASS}"
    printf 'HOSTNAME=%q\n' "${HOSTNAME}"
    printf 'LOCALE=%q\n' "${LOCALE}"
    printf 'TIMEZONE=%q\n' "${TIMEZONE}"
    printf 'KEYMAP=%q\n' "${KEYMAP}"
    printf 'CONSOLE_FONT=%q\n' "${CONSOLE_FONT}"
    printf 'DISK=%q\n' "${DISK}"
} > /mnt/root/install-vars.sh

# ── Run chroot install ────────────────────────────────────────────────────
header "Running post-install configuration"

[[ -f /mnt/root/post-install.sh ]] || die "Post-install script was not written to /mnt/root/post-install.sh."
arch-chroot /mnt bash /root/post-install.sh

# ── Cleanup ─────────────────────────────────────────────────────────────────
info "Cleaning up..."
rm -f /mnt/root/post-install.sh
rm -f /mnt/root/install-vars.sh

# ── Done ────────────────────────────────────────────────────────────────────
header "Installation Complete!"

echo "Your Dolores system has been installed successfully!"
echo ""
echo "Summary:"
echo "  Hostname:  ${HOSTNAME}"
echo "  User:      ${USERNAME}"
echo "  Locale:    ${LOCALE}"
echo "  Timezone:  ${TIMEZONE}"
echo "  Keymap:    ${KEYMAP}"
echo "  Disk:      ${DISK}"
echo ""
echo "Installed components:"
echo "  WM:        Mango (wlroots)"
echo "  Bar:       Waybar"
echo "  Launcher:  Rofi"
echo "  Terminal:  Ghostty"
echo "  Shell:     Zsh"
echo "  Login:     greetd (tuigreet)"
echo "  Audio:     PipeWire + WirePlumber"
echo "  Network:   NetworkManager + iwd"
echo "  Browser:   LibreWolf"
echo "  AUR:       paru"
echo ""
echo "To boot into your new system, reboot and remove the installation media."
echo "  reboot"
echo ""
